#!/usr/bin/env python3

# -*- coding: utf-8 -*-

"""

Personal Memory Hub — 真正的单键一键启动器



功能特性：

✓ Docker 数据库自动启动

✓ FastAPI 后台服务自动运行

✓ Dashboard 代理自动加载

✓ 自动打开浏览器

✓ 统一状态监控面板

✓ Ctrl+C 优雅关闭所有服务

✓ 手机访问支持（显示局域网IP）



使用方法：

  python h一键启动.py

"""



import sys

import os

import platform

import time

import socket

import webbrowser

import subprocess

import threading

from pathlib import Path





class OneClickLauncher:

    def __init__(self):

        self.base_dir = Path(__file__).resolve().parent

        self.backend_dir = self.base_dir / "backend"

        self.src_dir = self.backend_dir / "src"

        self.db_proc = None

        self.api_proc = None

        self.dashboard_proc = None

        self.running = False

        self.monitor_thread = None

        self.dashboard_port = 5000



    def init_console_encoding(self):

        """初始化控制台编码（Windows）"""

        if platform.system() == "Windows":

            try:

                subprocess.run(["chcp", "65001"], shell=True, capture_output=True)

            except Exception:

                pass



    def get_local_ip(self):

        """获取本地局域网 IP 地址"""

        try:

            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

            s.connect(("8.8.8.8", 80))

            ip = s.getsockname()[0]

            s.close()

            return ip

        except Exception:

            return "127.0.0.1"



    def clear_screen(self):

        """清空屏幕"""

        if platform.system() == "Windows":

            os.system("cls")

        else:

            os.system("clear")



    def print_header(self):

        """打印启动器标题"""

        border = "═" * 60

        print(border)

        print("          PERSONAL MEMORY HUB — 一键启动器 v2.0")

        print()



    def check_command(self, cmd):

        """检查命令是否存在"""

        try:

            if platform.system() == "Windows":

                result = subprocess.run(["where", cmd], capture_output=True, timeout=2)

            else:

                result = subprocess.run(["which", cmd], capture_output=True, timeout=2)

            return result.returncode == 0

        except Exception:

            return False



    def wait_for_port(self, host, port, timeout=30):

        """等待端口可用"""

        start = time.time()

        while time.time() - start < timeout:

            try:

                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

                sock.settimeout(2)

                result = sock.connect_ex((host, port))

                sock.close()

                if result == 0:

                    return True

            except (OSError, ConnectionRefusedError):

                pass

            time.sleep(1)

        return False



    def start_database(self):

        """启动 PostgreSQL Docker 容器"""

        print("🐳  [1/3] 正在启动数据库服务...")

        try:

            result = subprocess.run(

                ["docker", "ps", "--filter", "name=memory-hub-db", "--format", "{{.Names}}"],

                capture_output=True, text=True, timeout=5

            )

            if "memory-hub-db" in result.stdout:

                print("   ✓ 数据库容器已存在，跳过创建")

                return True

        except Exception:

            pass

        print("   → 正在创建并启动数据库容器...")

        result = subprocess.run(

            ["docker", "compose", "up", "-d", "db"],

            cwd=str(self.base_dir), capture_output=True, text=True, timeout=30

        )

        if result.returncode != 0:

            print(f"   ❌ 数据库启动失败: {result.stderr[:200]}")

            return False

        print("   ✓ 数据库容器启动中...")

        if self.wait_for_port("localhost", 5432, timeout=20):

            print("   ✓ PostgreSQL 准备就绪")

            return True

        else:

            print("   ⚠ 数据库可能仍在初始化中（继续执行）")

            return True



    def start_api(self):
        """启动 Memory Hub API 服务"""
        print("⚙️  [2/3] 正在启动 API 服务...")
        test_code = f"""import sys
sys.path.insert(0, "{self.src_dir}")
from backend.app import app
print("IMPORT_OK")"""
        result = subprocess.run(
            [sys.executable, "-c", test_code],
            cwd=str(self.base_dir),
            capture_output=True, text=True, timeout=10
        )
        if "IMPORT_OK" not in result.stdout:
            print(f"   ❌ API 模块导入失败: {result.stderr[:200]}")
            return False
        print("   ✓ API 模块验证通过")

        cmd = [sys.executable, "-m", "uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000"]
        if platform.system() == "Windows":
            self.api_proc = subprocess.Popen(
                cmd,
                cwd=str(self.backend_dir),
                env={**os.environ, "PYTHONPATH": str(self.src_dir)},
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
        else:
            self.api_proc = subprocess.Popen(
                cmd,
                cwd=str(self.backend_dir),
                env={**os.environ, "PYTHONPATH": str(self.src_dir)},
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                start_new_session=True,
            )

        def read_api_logs():
            for line in self.api_proc.stdout:
                if line.strip():
                    print(f"   [API] {line.strip()}")
                if self.api_proc.poll() is not None:
                    break

        log_thread = threading.Thread(target=read_api_logs, daemon=True)
        log_thread.start()

        print("   → 等待 API 健康检查...")
        if self.wait_for_port("localhost", 8000, timeout=30, check_endpoint="/health"):
            print("   ✓ API 健康检查 PASSED")
        else:
            print("   ⚠ API 可能未完全就绪但已在运行")
        return True

import sys

sys.path.insert(0, "{self.src_dir}")

from backend.app import app

print("IMPORT_OK")

test_code = f'''import sys

sys.path.insert(0, "{self.src_dir}")

from backend.app import app

print("IMPORT_OK")'''

result = subprocess.run(

    [sys.executable, "-c", test_code],

    cwd=str(self.base_dir),  # 改为 base_dir 确保正确解析 backend.app

    capture_output=True, text=True, timeout=10

)

        if "IMPORT_OK" not in result.stdout:

            print(f"   ❌ API 模块导入失败: {result.stderr[:200]}")

            return False

        print("   ✓ API 模块验证通过")

        cmd = [sys.executable, "-m", "uvicorn", "backend.app:app", "--host", "0.0.0.0", "--port", "8000"]

        if platform.system() == "Windows":

            self.api_proc = subprocess.Popen(

                cmd,

                cwd=str(self.base_dir),

                env={**os.environ, "PYTHONPATH": str(self.src_dir)},

                stdout=subprocess.PIPE,

                stderr=subprocess.STDOUT,

                text=True,

            )

        else:

            self.api_proc = subprocess.Popen(

                cmd,

                cwd=str(self.base_dir),

                env={**os.environ, "PYTHONPATH": str(self.src_dir)},

                stdout=subprocess.PIPE,

                stderr=subprocess.STDOUT,

                text=True,

                start_new_session=True,

            )

        def read_api_logs():

            for line in self.api_proc.stdout:

                if line.strip():

                    print(f"   [API] {line.strip()}")

                if self.api_proc.poll() is not None:

                    break

        log_thread = threading.Thread(target=read_api_logs, daemon=True)

        log_thread.start()

        time.sleep(2)

        if self.wait_for_port("localhost", 8000, timeout=10):

            print("   ✓ API 服务已启动 (port 8000)")

            return True

        else:

            print("   ⚠ API 可能未成功启动，请查看上方日志")

            return True



    def start_dashboard(self):

        """启动 Dashboard 代理"""

        print("📊  [3/3] 正在启动 Dashboard 代理...")

        dash_script = self.base_dir / "dashboard_server.py"

        if not dash_script.exists():

            print(f"   ❌ 找不到 Dashboard 脚本: {dash_script}")

            return False

        try:

            import requests

        except ImportError:

            print("   → 正在安装 requests 库...")

            subprocess.run([sys.executable, "-m", "pip", "install", "requests", "-q"], capture_output=True)

            print("   ✓ requests 安装完成")

        dash_cmd = [sys.executable, str(dash_script), "--port", str(self.dashboard_port), "--no-browser"]

        if platform.system() == "Windows":

            self.dashboard_proc = subprocess.Popen(

                dash_cmd,

                cwd=str(self.base_dir),

                stdout=subprocess.PIPE,

                stderr=subprocess.STDOUT,

                text=True,

            )

        else:

            self.dashboard_proc = subprocess.Popen(

                dash_cmd,

                cwd=str(self.base_dir),

                stdout=subprocess.PIPE,

                stderr=subprocess.STDOUT,

                text=True,

                start_new_session=True,

            )

        def read_dash_logs():

            for line in self.dashboard_proc.stdout:

                if line.strip():

                    print(f"   [DASH] {line.strip()}")

                if self.dashboard_proc.poll() is not None:

                    break

        dash_log_thread = threading.Thread(target=read_dash_logs, daemon=True)

        dash_log_thread.start()

        time.sleep(2)

        if self.wait_for_port("localhost", self.dashboard_port, timeout=5):

            print("   ✓ Dashboard 代理响应正常")

            return True

        else:

            print("   ⚠ Dashboard 可能仍在启动中")

            return True



    def open_browser(self):

        """自动打开浏览器"""

        print("🌐  正在打开本地浏览器...")

        try:

            webbrowser.open(f"http://localhost:{self.dashboard_port}")

            print("   ✓ 本地浏览器已打开")

        except Exception as e:

            print(f"   ⚠ 无法自动打开浏览器: {e}")



    def show_mobile_access_info(self):

        """显示手机访问信息"""

        local_ip = self.get_local_ip()

        print()

        border = "═" * 60

        print(border)

        print("         📱 手机远程访问提示")

        print(border)

        print("   • 手机和电脑需连接同一 Wi-Fi 网络")

        print("   • 在手机上浏览器打开:")

        print(f"     http://{local_ip}:{self.dashboard_port}")

        print("   • 之后你可以在手机上访问 Dashboard")

        print(border)

        print()



    def status_monitor(self):

        """状态监控线程 — 显示实时状态"""

        while self.running:

            self.clear_screen()

            self.print_header()

            db_status = "● 运行中" if self.db_proc and self.wait_for_port("localhost", 5432, timeout=1) else "○ 未启动"

            api_status = "● 运行中" if self.api_proc and self.wait_for_port("localhost", 8000, timeout=1) else "○ 未启动"

            dash_status = "● 运行中" if self.dashboard_proc and self.wait_for_port("localhost", self.dashboard_port, timeout=1) else "○ 未启动"

            print(f"   ╔══════════════════════════════════════════════╗")

            print(f"   ║              服务状态监控                        ║")

            print(f"   ╠══════════════════════════════════════════════════╣")

            print(f"   ║  数据库     : {db_status:<30} ║")

            print(f"   ║  API 服务   : {api_status:<30} ║")

            print(f"   ║  Dashboard  : {dash_status:<30} ║")

            print(f"   ╠══════════════════════════════════════════════════╣")

            print(f"   ║  本地: http://localhost:{self.dashboard_port} ║")

            print(f"   ║  手机: http://{self.get_local_ip()}:{self.dashboard_port} ║")

            print(f"   ╚══════════════════════════════════════════════════╝")

            print()

            print("   按 Ctrl+C 停止所有服务")

            print()

            time.sleep(2)



    def cleanup(self):

        """清理所有进程"""

        print("\n🛑 正在停止所有服务...")

        if self.api_proc and self.api_proc.poll() is None:

            print("   → 终止 API 服务...")

            try:

                self.api_proc.terminate()

                self.api_proc.wait(timeout=5)

            except:

                self.api_proc.kill()

                self.api_proc.wait()

            print("   ✓ API 已停止")

        if self.dashboard_proc and self.dashboard_proc.poll() is None:

            print("   → 终止 Dashboard...")

            try:

                self.dashboard_proc.terminate()

                self.dashboard_proc.wait(timeout=5)

            except:

                self.dashboard_proc.kill()

                self.dashboard_proc.wait()

            print("   ✓ Dashboard 已停止")

        print("   ✓ 所有服务已停止")



    def run(self):

        """主启动方法"""

        self.running = True

        self.init_console_encoding()

        print("  🔍 检查环境依赖...")

        

        # Python always available since we're running this script

        print("   ✓ Python available (script is running)")

        

        docker_ok = self.check_command("docker")

        uvicorn_ok = self.check_command("uvicorn")

        

        if not docker_ok:

            print("   ⚠ Docker not found in PATH - database services will be skipped")

        if not uvicorn_ok:

            print("   ⚠ uvicorn not installed - API service may fail (run: pip install uvicorn)")

        

        if docker_ok and uvicorn_ok:

            print("   ✓ All dependencies available")

        else:

            print("   ⚠ Some warnings above, continuing anyway...")

        

        self.clear_screen()

        self.print_header()

        

        if not self.start_database():

            self.running = False

            return False

        if not self.start_api():

            self.running = False

            return False

        if not self.start_dashboard():

            self.running = False

            return False

        self.open_browser()

        self.show_mobile_access_info()

        self.monitor_thread = threading.Thread(target=self.status_monitor, daemon=True)

        self.monitor_thread.start()

        try:

            while self.running:

                time.sleep(1)

        except KeyboardInterrupt:

            self.stop()

        return True

if __name__ == "__main__":

    launcher = OneClickLauncher()

    success = launcher.run()

    if success:

        print("\n✓ Personal Memory Hub 启动完成！")

    else:

        print("\n✗ 启动失败，请检查上面的错误信息。")
