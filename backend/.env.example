# Personal Memory Hub — Environment Variables Template
#
# Copy this file to .env and adjust values for your environment.
# Do NOT commit .env to version control.
#
# All configuration values are loaded via pydantic-settings with
# the APP_ prefix.  Database-specific variables use no prefix.

# ===================================================================
# General
# ===================================================================
APP_NAME=personal-memory-hub
APP_VERSION=0.1.0
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO

# ===================================================================
# Database (PostgreSQL / Supabase)
# ===================================================================
# PostgreSQL connection string (async)
# Format: postgresql+asyncpg://user:password@host:port/database
# Local default: postgresql+asyncpg://postgres:postgres@localhost:5432/memory_hub
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/memory_hub
# Enable SQL echo to console (useful for debugging)
DATABASE_ECHO=false

# ===================================================================
# Supabase (optional — used for hosted PostgreSQL + pgvector)
# ===================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ===================================================================
# Vector / Embeddings
# ===================================================================
# Embedding vector dimension (1536 for OpenAI ada-002)
VECTOR_DIMENSION=1536

# ===================================================================
# Redis (V2+ placeholder — for caching, pub/sub)
# ===================================================================
REDIS_URL=

# ===================================================================
# LLM / OpenRouter (deferred to D3+)
# ===================================================================
OPENROUTER_API_KEY=
